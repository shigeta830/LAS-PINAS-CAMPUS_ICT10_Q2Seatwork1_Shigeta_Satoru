 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="https://pyscript.net" />
<script type="module" src="https://pyscript.net"></script>
<link rel="preconnect" href="https://googleapis.com">
<link rel="preconnect" href="https://gstatic.com" crossorigin>
<link
href="https://googleapis.com/css2?family=Orbitron:wght@600;800&family=Rajdhani:wght
@400;600&display=swap" rel="stylesheet">

    <style>
        /* 1. Page Background and Base Fonts */
        body {
            background-color: #111111; /* Clean dark black background */
            color: #ffffff;            /* White text for general readability */
            font-family: 'Rajdhani', sans-serif;
            text-align: center;        /* Centers all text and elements on the screen */
            padding-top: 50px;
        }

        /* 2. Heading Style */
        h1 {
            font-family: 'Orbitron', sans-serif;
            color: #d4af37;            /* Classic Gold Color */
            font-size: 3rem;
            margin: 10px 0;
        }

        /* 3. The Reactor Circle */
        .reactor {
            width: 40px;
            height: 40px;
            background-color: #d4af37; /* Solid gold fill */
            border-radius: 50%;        /* Makes the square div a perfect circle */
            margin: 0 auto;            /* Centers the circle horizontally */
        }

        /* 4. Text Input Boxes */
        input[type="text"] {
            background-color: #222222; /* Dark grey input background */
            border: 2px solid #d4af37; /* Gold border outline */
            color: #ffffff;            /* Type in white text */
            padding: 10px;
            margin: 8px 0;
            width: 250px;
            font-family: 'Rajdhani', sans-serif;
            font-size: 1rem;
            border-radius: 4px;        /* Slightly rounds the input corners */
        }

        /* 5. The Enter Button */
        input[type="button"] {
            background-color: #d4af37; /* Gold background */
            color: #111111;            /* Dark text inside button for contrast */
            border: none;
            padding: 12px 30px;
            margin-top: 10px;
            font-family: 'Orbitron', sans-serif;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;           /* Changes mouse cursor to a hand pointing icon */
            border-radius: 4px;
        }

        /* Button Hover Effect */
        input[type="button"]:hover {
            background-color: #f3e5ab; /* Shifts to a lighter gold when mouse hovers over it */
        }

        /* 6. Result Box */
        #result {
            margin-top: 20px;
            font-size: 1.5rem;
            color: #d4af37;            /* Gold text for results output */
            font-family: 'Orbitron', sans-serif;
        }
    </style>
</head>
<body>
     <header>
        <div class="reactor"></div>\
        <h1>Gooner club</h1>
        <p>This is a club full of gooners</p>
     </header>
    

     <main>
         <form>
             <input type="text" id="first_name" placeholder="Enter your first name"><br>
             <input type="text" id="last_name" placeholder="Enter your last name"><br>
             <input type="button" py-click="candidate_checker" value="Enter">
         </form>
         <div id="result"></div>
     </main>

</body>
</html>


 

